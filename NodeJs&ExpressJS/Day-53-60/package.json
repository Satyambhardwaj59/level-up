{
  "name": "task-management-api",
  "version": "1.0.0",
  "description": "Production-ready Task Management REST API with JWT auth, RBAC, and full CRUD",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node ./node_modules/jest/bin/jest.js --runInBand --forceExit --detectOpenHandles",
    "test:coverage": "node ./node_modules/jest/bin/jest.js --coverage --runInBand --forceExit --detectOpenHandles"
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "jwt",
    "rest-api"
  ],
  "author": "Satyam",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.1",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "globalSetup": null,
    "setupFiles": [
      "./tests/setup.js"
    ]
  },
  "allowScripts": {
    "mongodb-memory-server@11.2.0": true
  }
}
